:noaa-cdr-solar-spectral-irradiance-pds_daily a qb:DataSet,
        dcat:Dataset,
        schema:Dataset ;
    rdfs:label "Daily SSI calculated using NRL2 solar irradiance model. Includes spectrally integrated (total) TSI value" ;
    dcterms:description "This dataset contains spectral solar irradiance as a function of time and wavelength created with the Naval Research Laboratory model for spectral and total irradiance. Spectral solar irradiance is the wavelength-dependent energy input to the top of the Earth’s atmosphere, at a standard distance of one Astronomical Unit from the Sun. Its units are W per m2 per nm. Also included is the value of total (spectrally integrated) solar irradiance in units W per m2. The dataset is created by Judith Lean (Space Science Division, Naval Research Laboratory), and Odele Coddington, Peter Pilewskie, Martin Snow, Chris Lindholm, and Doug Lindholm (Laboratory for Atmospheric and Space Science, University of Colorado), and NOAA CDR Program." ;
    dcterms:title "Daily SSI calculated using NRL2 solar irradiance model. Includes spectrally integrated (total) TSI value" ;
    qb:structure [ a qb:DataStructureDefinition ;
            qb:component [ a qb:ComponentSpecification ;
                    :field_name "time" ;
                    qb:dimension :time ],
                [ qb:measure :solar_irradiance_noaa-cdr-solar-spectral-irradiance-pds_daily ] ],
        [ a qb:DataStructureDefinition ;
            qb:component [ a qb:ComponentSpecification ;
                    :field_name "wavelength" ;
                    qb:dimension :radiation_wavelength ],
                [ a qb:ComponentSpecification ;
                    :field_name "time" ;
                    qb:dimension :time ],
                [ qb:measure :solar_irradiance_per_unit_wavelength_noaa-cdr-solar-spectral-irradiance-pds_daily ] ] ;
    rdfs:comment "This dataset contains spectral solar irradiance as a function of time and wavelength created with the Naval Research Laboratory model for spectral and total irradiance. Spectral solar irradiance is the wavelength-dependent energy input to the top of the Earth’s atmosphere, at a standard distance of one Astronomical Unit from the Sun. Its units are W per m2 per nm. Also included is the value of total (spectrally integrated) solar irradiance in units W per m2. The dataset is created by Judith Lean (Space Science Division, Naval Research Laboratory), and Odele Coddington, Peter Pilewskie, Martin Snow, Chris Lindholm, and Doug Lindholm (Laboratory for Atmospheric and Space Science, University of Colorado), and NOAA CDR Program." ;
    dcat:distribution [ a dcat:Distribution ;
            dcat:accessURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/icechunk/noaa-cdr-solar-spectral-irradiance-pds/daily> ;
            dcat:mediaType "application/icechunk-zarr" ] ;
    dcat:endDate "2023-12-31T00:00:00+00:00"^^xsd:dateTime ;
    dcat:startDate "1882-01-01T00:00:00+00:00"^^xsd:dateTime ;
    schema:contentUrl <s3://data-c6c22a2e42294c11b52ee7f0c792c071/icechunk/noaa-cdr-solar-spectral-irradiance-pds/daily> ;
    schema:description "This dataset contains spectral solar irradiance as a function of time and wavelength created with the Naval Research Laboratory model for spectral and total irradiance. Spectral solar irradiance is the wavelength-dependent energy input to the top of the Earth’s atmosphere, at a standard distance of one Astronomical Unit from the Sun. Its units are W per m2 per nm. Also included is the value of total (spectrally integrated) solar irradiance in units W per m2. The dataset is created by Judith Lean (Space Science Division, Naval Research Laboratory), and Odele Coddington, Peter Pilewskie, Martin Snow, Chris Lindholm, and Doug Lindholm (Laboratory for Atmospheric and Space Science, University of Colorado), and NOAA CDR Program." ;
    schema:isAccessibleForFree true ;
    schema:keywords "Earth Science &gt; Atmosphere &gt; Atmospheric Radiation &gt; Incoming Solar Radiation",
        "Earth Science &gt; Atmosphere &gt; Atmospheric Radiation &gt; Solar Irradiance",
        "Earth Science &gt; Atmosphere &gt; Atmospheric Radiation &gt; Solar Radiation",
        "Earth Science &gt; Climate Indicators &gt; Paleoclimate Indicators &gt; Paleoclimate Reconstructions &gt; Solar Forcing/Insolation Reconstruction",
        "Earth Science &gt; Climate Indicators &gt; Sun-Earth Interactions &gt; Solar Activity &gt; Solar Irradiance",
