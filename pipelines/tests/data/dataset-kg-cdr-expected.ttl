    schema:version "2" .

:noaa-cdr-solar-spectral-irradiance-pds_high-resolution-daily a qb:DataSet,
        dcat:Dataset,
        schema:Dataset ;
    rdfs:label "Daily high resolution SSI calculated using NNL1 solar irradiance model" ;
    dcterms:description "This Climate Data Record (CDR) contains solar spectral irradiance (SSI) as a function of time and wavelength created with the NASA NOAA LASP (NNL) Version 1 model for total, spectral and high-resolution spectral solar irradiance. The CDR Version 3 improves the scientific quality of the earlier version, version 2.1, based on new research from several NASA Solar Irradiance Science Team activities, from improved accuracy, precision and stability of solar irradiance observations made by the TSIS-1 mission, and from operational and improved sources for facular brightening and sunspot darkening proxies. Solar spectral irradiance is the wavelength-dependent energy input to the top of the Earth's atmosphere, at a standard distance of one Astronomical Unit from the Sun. Its units are W per m2 per nm. Also included is the value of total (spectrally integrated) solar irradiance in units W per m2. The high-resolution spectral solar irradiance dataset, from 115-500 nm spectral range, is consistent in magnitude and variability with the binned SSI product from ~0 nm to 200,000 nm. The dataset was created by Odele Coddington, Judith Lean, Chris Lindholm, and Peter Pilewskie (Laboratory for Atmospheric and Space Science, University of Colorado). The daily- and monthly-averaged SSI and high-resolution SSI data products range from 1874 to the present, and annual-averaged SSI and high-resolution SSI data products begin in 1610. The data file formats are netCDF-4 following CF metadata conventions. The datasets are accompanied by algorithm documentation, data flow diagram and source code for the NOAA CDR Program." ;
    dcterms:title "Daily high resolution SSI calculated using NNL1 solar irradiance model" ;
    qb:structure [ a qb:DataStructureDefinition ;
            qb:component [ a qb:ComponentSpecification ;
                    :field_name "time" ;
                    qb:dimension :time ],
                [ a qb:ComponentSpecification ;
                    :field_name "wavelength" ;
                    qb:dimension :radiation_wavelength ],
                [ qb:measure :solar_irradiance_per_unit_wavelength_noaa-cdr-solar-spectral-irradiance-pds_high-resolution-daily ] ] ;
    rdfs:comment "This Climate Data Record (CDR) contains solar spectral irradiance (SSI) as a function of time and wavelength created with the NASA NOAA LASP (NNL) Version 1 model for total, spectral and high-resolution spectral solar irradiance. The CDR Version 3 improves the scientific quality of the earlier version, version 2.1, based on new research from several NASA Solar Irradiance Science Team activities, from improved accuracy, precision and stability of solar irradiance observations made by the TSIS-1 mission, and from operational and improved sources for facular brightening and sunspot darkening proxies. Solar spectral irradiance is the wavelength-dependent energy input to the top of the Earth's atmosphere, at a standard distance of one Astronomical Unit from the Sun. Its units are W per m2 per nm. Also included is the value of total (spectrally integrated) solar irradiance in units W per m2. The high-resolution spectral solar irradiance dataset, from 115-500 nm spectral range, is consistent in magnitude and variability with the binned SSI product from ~0 nm to 200,000 nm. The dataset was created by Odele Coddington, Judith Lean, Chris Lindholm, and Peter Pilewskie (Laboratory for Atmospheric and Space Science, University of Colorado). The daily- and monthly-averaged SSI and high-resolution SSI data products range from 1874 to the present, and annual-averaged SSI and high-resolution SSI data products begin in 1610. The data file formats are netCDF-4 following CF metadata conventions. The datasets are accompanied by algorithm documentation, data flow diagram and source code for the NOAA CDR Program." ;
    dcat:distribution [ a dcat:Distribution ;
            dcat:accessURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/icechunk/noaa-cdr-solar-spectral-irradiance-pds/high-resolution-daily> ;
            dcat:mediaType "application/icechunk-zarr" ] ;
    dcat:endDate "2025-12-31T00:00:00+00:00"^^xsd:dateTime ;
    dcat:startDate "2024-01-01T00:00:00+00:00"^^xsd:dateTime ;
    schema:contentUrl <s3://data-c6c22a2e42294c11b52ee7f0c792c071/icechunk/noaa-cdr-solar-spectral-irradiance-pds/high-resolution-daily> ;
    schema:description "This Climate Data Record (CDR) contains solar spectral irradiance (SSI) as a function of time and wavelength created with the NASA NOAA LASP (NNL) Version 1 model for total, spectral and high-resolution spectral solar irradiance. The CDR Version 3 improves the scientific quality of the earlier version, version 2.1, based on new research from several NASA Solar Irradiance Science Team activities, from improved accuracy, precision and stability of solar irradiance observations made by the TSIS-1 mission, and from operational and improved sources for facular brightening and sunspot darkening proxies. Solar spectral irradiance is the wavelength-dependent energy input to the top of the Earth's atmosphere, at a standard distance of one Astronomical Unit from the Sun. Its units are W per m2 per nm. Also included is the value of total (spectrally integrated) solar irradiance in units W per m2. The high-resolution spectral solar irradiance dataset, from 115-500 nm spectral range, is consistent in magnitude and variability with the binned SSI product from ~0 nm to 200,000 nm. The dataset was created by Odele Coddington, Judith Lean, Chris Lindholm, and Peter Pilewskie (Laboratory for Atmospheric and Space Science, University of Colorado). The daily- and monthly-averaged SSI and high-resolution SSI data products range from 1874 to the present, and annual-averaged SSI and high-resolution SSI data products begin in 1610. The data file formats are netCDF-4 following CF metadata conventions. The datasets are accompanied by algorithm documentation, data flow diagram and source code for the NOAA CDR Program." ;
    schema:isAccessibleForFree true ;
    schema:keywords "Earth Science &gt; Atmosphere &gt; Atmospheric Radiation &gt; Incoming Solar Radiation",
        "Earth Science &gt; Atmosphere &gt; Atmospheric Radiation &gt; Solar Irradiance",
