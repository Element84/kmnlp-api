:noaa-cdr-leaf-area-index-fapar-pds_daily a qb:DataSet,
        dcat:Dataset,
        schema:Dataset ;
    rdfs:label "Leaf Area and Fraction of Absorbed Photosynthetically Active Radiation parameters derived from NOAA-20 data for day 2026/225" ;
