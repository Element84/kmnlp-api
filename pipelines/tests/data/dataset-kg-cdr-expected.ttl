    schema:name "Daily SSI calculated using NRL2 solar irradiance model. Includes spectrally integrated (total) TSI value" ;
    schema:url <http://doi.org/10.7289/V53776SW> ;
    schema:variableMeasured :radiation_wavelength,
        :solar_irradiance_noaa-cdr-solar-spectral-irradiance-pds_daily,
