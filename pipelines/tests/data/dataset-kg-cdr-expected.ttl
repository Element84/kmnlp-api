:noaa-cdr-solar-spectral-irradiance-pds_monthly a qb:DataSet,
        dcat:Dataset,
        schema:Dataset ;
    rdfs:label "Monthly SSI calculated using NRL2 solar irradiance model. Includes spectrally integrated (total) TSI value" ;
    dcterms:description "This dataset contains spectral solar irradiance as a function of time and wavelength created with the Naval Research Laboratory model for spectral and total irradiance. Spectral solar irradiance is the wavelength-dependent energy input to the top of the Earth’s atmosphere, at a standard distance of one Astronomical Unit from the Sun. Its units are W per m2 per nm. Also included is the value of total (spectrally integrated) solar irradiance in units W per m2. The dataset is created by Judith Lean (Space Science Division, Naval Research Laboratory), and Odele Coddington, Peter Pilewskie, Martin Snow, Chris Lindholm, and Doug Lindholm (Laboratory for Atmospheric and Space Science, University of Colorado), and NOAA CDR Program." ;
    dcterms:title "Monthly SSI calculated using NRL2 solar irradiance model. Includes spectrally integrated (total) TSI value" ;
    qb:structure [ a qb:DataStructureDefinition ;
            qb:component [ a qb:ComponentSpecification ;
                    :field_name "wavelength" ;
                    qb:dimension :radiation_wavelength ],
                [ qb:measure :solar_irradiance_per_unit_wavelength_noaa-cdr-solar-spectral-irradiance-pds_monthly ],
                [ a qb:ComponentSpecification ;
                    :field_name "time" ;
                    qb:dimension :time ] ],
        [ a qb:DataStructureDefinition ;
            qb:component [ qb:measure :solar_irradiance_noaa-cdr-solar-spectral-irradiance-pds_monthly ],
                [ a qb:ComponentSpecification ;
                    :field_name "time" ;
                    qb:dimension :time ] ] ;
    rdfs:comment "This dataset contains spectral solar irradiance as a function of time and wavelength created with the Naval Research Laboratory model for spectral and total irradiance. Spectral solar irradiance is the wavelength-dependent energy input to the top of the Earth’s atmosphere, at a standard distance of one Astronomical Unit from the Sun. Its units are W per m2 per nm. Also included is the value of total (spectrally integrated) solar irradiance in units W per m2. The dataset is created by Judith Lean (Space Science Division, Naval Research Laboratory), and Odele Coddington, Peter Pilewskie, Martin Snow, Chris Lindholm, and Doug Lindholm (Laboratory for Atmospheric and Space Science, University of Colorado), and NOAA CDR Program." ;
    dcat:distribution [ a dcat:Distribution ;
            dcat:accessURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/icechunk/noaa-cdr-solar-spectral-irradiance-pds/monthly> ;
