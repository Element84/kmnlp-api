:cf_standard_name a rdf:Property ;
    rdfs:label "Matching entry in the CF Standard Names table." ;
    rdfs:range cf:Standard_Name .

:field_name a rdf:Property ;
    rdfs:label "Field name in the dataset." ;
    rdfs:range xsd:string .

:noaa-cdr-aerosol-optical-thickness-pds_daily a qb:DataSet,
        dcat:Dataset,
        schema:Dataset ;
    rdfs:label "Daily AVHRR Aerosol Optical Thickness over Global Oceans, Version 4.0" ;
    dcterms:description "The product is the aerosol optical thickness (AOT) at 0.65 micron, which is retrieved from NOAA PATMOS-x and JPSS level-2B orbital radinace and cloud CDR products. The retrieval is performed for selected spatial(0.1 by 0.1 degree) and temporal (1 time per day per satellite) resolution in cloud free condition during daytime. The final product is daily avergaed from all satellite retrivals and in a 0.1 by 0.1 degree equal angle grid (total 1800x3600 grids over the globe). Due to the relatively large uncertainties associated with surface reflectance over water glint area and land surface as well as limited AVHRR retrieval channels, the current algorithm only performs retrieval over none-glint water surface (specifically at the anti-solar side of the orbit and viewing angle is larger than 40 degree away from the specular ray). The final CDR AOT products include daily and monthly products" ;
    dcterms:title "Daily AVHRR Aerosol Optical Thickness over Global Oceans, Version 4.0" ;
    qb:structure [ a qb:DataStructureDefinition ;
            qb:component [ a qb:ComponentSpecification ;
                    :field_name "latitude" ;
                    qb:dimension :latitude ],
                [ qb:measure :atmosphere_optical_thickness_due_to_ambient_aerosol_noaa-cdr-aerosol-optical-thickness-pds_daily ],
                [ a qb:ComponentSpecification ;
                    :field_name "longitude" ;
                    qb:dimension :longitude ],
                [ a qb:ComponentSpecification ;
                    :field_name "time" ;
                    qb:dimension :time ] ] ;
    rdfs:comment "The product is the aerosol optical thickness (AOT) at 0.65 micron, which is retrieved from NOAA PATMOS-x and JPSS level-2B orbital radinace and cloud CDR products. The retrieval is performed for selected spatial(0.1 by 0.1 degree) and temporal (1 time per day per satellite) resolution in cloud free condition during daytime. The final product is daily avergaed from all satellite retrivals and in a 0.1 by 0.1 degree equal angle grid (total 1800x3600 grids over the globe). Due to the relatively large uncertainties associated with surface reflectance over water glint area and land surface as well as limited AVHRR retrieval channels, the current algorithm only performs retrieval over none-glint water surface (specifically at the anti-solar side of the orbit and viewing angle is larger than 40 degree away from the specular ray). The final CDR AOT products include daily and monthly products" ;
    dcat:distribution [ a dcat:Distribution ;
            dcat:accessURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/icechunk/noaa-cdr-aerosol-optical-thickness-pds/daily> ;
            dcat:mediaType "application/icechunk-zarr" ] ;
    dcat:endDate "2026-06-30T00:00:00+00:00"^^xsd:dateTime ;
    dcat:startDate "1982-01-01T00:00:00+00:00"^^xsd:dateTime ;
    schema:contentUrl <s3://data-c6c22a2e42294c11b52ee7f0c792c071/icechunk/noaa-cdr-aerosol-optical-thickness-pds/daily> ;
    schema:description "The product is the aerosol optical thickness (AOT) at 0.65 micron, which is retrieved from NOAA PATMOS-x and JPSS level-2B orbital radinace and cloud CDR products. The retrieval is performed for selected spatial(0.1 by 0.1 degree) and temporal (1 time per day per satellite) resolution in cloud free condition during daytime. The final product is daily avergaed from all satellite retrivals and in a 0.1 by 0.1 degree equal angle grid (total 1800x3600 grids over the globe). Due to the relatively large uncertainties associated with surface reflectance over water glint area and land surface as well as limited AVHRR retrieval channels, the current algorithm only performs retrieval over none-glint water surface (specifically at the anti-solar side of the orbit and viewing angle is larger than 40 degree away from the specular ray). The final CDR AOT products include daily and monthly products" ;
    schema:isAccessibleForFree true ;
    schema:keywords "" ;
    schema:name "Daily AVHRR Aerosol Optical Thickness over Global Oceans, Version 4.0" ;
    schema:url <https://www.ncei.noaa.gov/access/metadata/landing-page/bin/iso?id=gov.noaa.ncdc:C01678> ;
    schema:variableMeasured :atmosphere_optical_thickness_due_to_ambient_aerosol_noaa-cdr-aerosol-optical-thickness-pds_daily,
        :latitude,
        :longitude,
        :time ;
    schema:version "2" .

