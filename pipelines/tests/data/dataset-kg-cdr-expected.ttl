    dcterms:title "Leaf Area and Fraction of Absorbed Photosynthetically Active Radiation parameters derived from NOAA-20 data for day 2026/225" ;
    qb:structure [ a qb:DataStructureDefinition ;
            qb:component [ qb:measure :fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation_noaa-cdr-leaf-area-index-fapar-pds_daily ],
                [ a qb:ComponentSpecification ;
                    :field_name "longitude" ;
                    qb:dimension :longitude ],
                [ a qb:ComponentSpecification ;
                    :field_name "time" ;
                    qb:dimension :time ],
                [ a qb:ComponentSpecification ;
                    :field_name "latitude" ;
                    qb:dimension :latitude ] ],
        [ a qb:DataStructureDefinition ;
            qb:component [ a qb:ComponentSpecification ;
                    :field_name "latitude" ;
                    qb:dimension :latitude ],
                [ qb:measure :leaf_area_index_noaa-cdr-leaf-area-index-fapar-pds_daily ],
                [ a qb:ComponentSpecification ;
                    :field_name "time" ;
                    qb:dimension :time ],
                [ a qb:ComponentSpecification ;
                    :field_name "longitude" ;
                    qb:dimension :longitude ] ] ;
    rdfs:comment "VIIRS data from NOAA-20 for 2026, days 225 to 225, processed by the Long-Term Land Data Record (LTDR) project (v002) into Leaf Area, Fraction of Absorbed Photosynthetically Active Radiation and quality-control flags. " ;
