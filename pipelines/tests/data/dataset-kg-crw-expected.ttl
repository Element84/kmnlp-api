:cf_standard_name a rdf:Property ;
    rdfs:label "Matching entry in the CF Standard Names table." ;
    rdfs:range cf:Standard_Name .

:crw_sst_annual_max a qb:DataSet,
        dcat:Dataset,
        schema:Dataset ;
    rdfs:label "NOAA Coral Reef Watch Global 5km Satellite Sea Surface Temperature (CoralTemp) Annual Maximum Composite for 2025" ;
    dcterms:description "This is a product of NOAA Coral Reef Watch Daily Global 5km Satellite Coral Bleaching Heat Stress Monitoring Product Suite" ;
    dcterms:title "NOAA Coral Reef Watch Global 5km Satellite Sea Surface Temperature (CoralTemp) Annual Maximum Composite for 2025" ;
    qb:structure [ a qb:DataStructureDefinition ;
            qb:component [ a qb:ComponentSpecification ;
                    :field_name "time" ;
                    qb:dimension :time ],
                [ a qb:ComponentSpecification ;
                    :field_name "lat" ;
                    qb:dimension :latitude ],
                [ qb:measure :mask_crw_sst_annual_max ],
                [ a qb:ComponentSpecification ;
                    :field_name "lon" ;
                    qb:dimension :longitude ] ],
        [ a qb:DataStructureDefinition ;
            qb:component [ a qb:ComponentSpecification ;
                    :field_name "lon" ;
                    qb:dimension :longitude ],
                [ qb:measure :sea_surface_temperature_crw_sst_annual_max ],
                [ a qb:ComponentSpecification ;
                    :field_name "time" ;
                    qb:dimension :time ],
                [ a qb:ComponentSpecification ;
                    :field_name "lat" ;
                    qb:dimension :latitude ] ] ;
    rdfs:comment "This is a product of NOAA Coral Reef Watch Daily Global 5km Satellite Coral Bleaching Heat Stress Monitoring Product Suite" ;
    dcat:distribution [ a dcat:Distribution ;
            dcat:accessURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/icechunk/crw/sst_annual_max> ;
            dcat:mediaType "application/icechunk-zarr" ] ;
    dcat:endDate "2025-12-31T12:00:00+00:00"^^xsd:dateTime ;
    dcat:startDate "1985-12-31T12:00:00+00:00"^^xsd:dateTime ;
    dcat:temporalResolution "P1Y"^^xsd:duration ;
    schema:contentUrl <s3://data-c6c22a2e42294c11b52ee7f0c792c071/icechunk/crw/sst_annual_max> ;
    schema:description "This is a product of NOAA Coral Reef Watch Daily Global 5km Satellite Coral Bleaching Heat Stress Monitoring Product Suite" ;
    schema:isAccessibleForFree true ;
    schema:keywords "Oceans > Ocean Temperature > Sea Surface Temperature",
        "Oceans > Ocean Temperature > Water Temperature",
        "Spectral/Engineering > Infrared Wavelengths > Thermal Infrared" ;
    schema:name "NOAA Coral Reef Watch Global 5km Satellite Sea Surface Temperature (CoralTemp) Annual Maximum Composite for 2025" ;
    schema:url <https://coralreefwatch.noaa.gov/product/5km/index.php> ;
    schema:variableMeasured :latitude,
        :longitude,
        :mask_crw_sst_annual_max,
        :sea_surface_temperature_crw_sst_annual_max,
        :time ;
    schema:version "2" .

